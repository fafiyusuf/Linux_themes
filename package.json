{
  "name": "aura",
  "version": "0.1.0",
  "description": "Linux theme manager for GNOME",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "NODE_ENV=production electron .",
    "preelectron:dev": "fuser -k 5173/tcp 2>/dev/null; fuser -k 5174/tcp 2>/dev/null; fuser -k 5175/tcp 2>/dev/null; true",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite --port 5173\" \"wait-on http://localhost:5173 && ELECTRON_OZONE_PLATFORM_HINT=auto NODE_ENV=development electron .\"",
    "lint": "oxlint"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.1.2",
    "electron": "^35.2.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "wait-on": "^8.0.3"
  }
}